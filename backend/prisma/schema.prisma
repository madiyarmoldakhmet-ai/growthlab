// GrowthLab — Clean MVP schema (night refactor).
// Only 4 domain tables. Old entanglement with Leads/Channels/Events is gone.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Enums ─────────────────────────────────────────────
enum CampaignStatus {
  ACTIVE
  PAUSED
}

enum ChannelType {
  GMAIL
  WHATSAPP
  INSTAGRAM
}

// Platforms supported by SendingAccount (reusable sending identities with stored sessions).
enum SendingPlatform {
  GMAIL
  WHATSAPP
  INSTAGRAM
}

enum SendingAccountStatus {
  ACTIVE
  PAUSED
}

enum ContactStatus {
  NEW
  QUEUED
  SENT
  REPLIED
}

enum MessageStatus {
  QUEUED
  SENT
  FAILED
}

// ─── Models ────────────────────────────────────────────

// Top-level account/customer that groups campaigns.
model Client {
  id        String     @id @default(uuid()) @db.Uuid
  name      String
  industry  String?
  campaigns Campaign[]
  createdAt DateTime   @default(now()) @map("created_at")

  @@map("clients")
}

// A campaign belongs to a client and holds contacts.
model Campaign {
  id        String         @id @default(uuid()) @db.Uuid
  clientId  String         @map("client_id") @db.Uuid
  client    Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name      String
  status    CampaignStatus @default(ACTIVE)
  contacts  Contact[]
  createdAt DateTime       @default(now()) @map("created_at")

  @@index([clientId])
  @@map("campaigns")
}

// A contact is a recipient within a campaign.
model Contact {
  id          String       @id @default(uuid()) @db.Uuid
  campaignId  String       @map("campaign_id") @db.Uuid
  campaign    Campaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  fullName    String       @map("full_name")
  email       String?
  phone       String?
  channelType ChannelType  @map("channel_type")
  status      ContactStatus @default(NEW)
  messages    Message[]
  createdAt   DateTime     @default(now()) @map("created_at")

  @@index([campaignId])
  @@index([status])
  @@map("contacts")
}

// Outbound message log: one row per send attempt.
model Message {
  id        String        @id @default(uuid()) @db.Uuid
  contactId String        @map("contact_id") @db.Uuid
  contact   Contact       @relation(fields: [contactId], references: [id], onDelete: Cascade)
  channel   ChannelType
  text      String
  status    MessageStatus @default(QUEUED)
  waLink    String?       @map("wa_link")
  createdAt DateTime      @default(now()) @map("created_at")

  @@index([contactId])
  @@map("messages")
}

// Reusable outbound identity with stored session (e.g. Instagram cookies for Puppeteer).
// sessionCookies holds a JSON string; format depends on the platform.
model SendingAccount {
  id            String               @id @default(uuid()) @db.Uuid
  platform      SendingPlatform      @default(INSTAGRAM)
  identifier    String
  sessionCookies String
  status        SendingAccountStatus @default(ACTIVE)
  createdAt     DateTime             @default(now()) @map("created_at")
  updatedAt     DateTime             @updatedAt        @map("updated_at")

  @@index([platform, status])
  @@map("sending_accounts")
}
