# ─── App ───────────────────────────────────────────────
NODE_ENV=development
PORT=3001
# Comma-separated allowed origins for CORS (empty = allow all in dev)
CORS_ORIGIN=
# Max upload size for CSV/Excel imports, in bytes
UPLOAD_MAX_BYTES=5242880

# ─── Database (required) ───────────────────────────────
# PostgreSQL connection string. Create a DB named "growthlab" first.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/growthlab?schema=public"

# ─── Auth (required) ───────────────────────────────────
# JWT_SECRET must be at least 16 characters — generate a long random string.
JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN_SECONDS=86400
# Bootstrap admin. On first login a real User + Organization are created in the DB.
ADMIN_EMAIL="admin@growthlab.local"
ADMIN_PASSWORD="change-this-password"

# ─── AI: email personalization (OpenAI-compatible) ─────
# platform.openai.com → API keys. Empty = deterministic rule-based fallback (no network).
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
OPENAI_BASE_URL="https://api.openai.com/v1"

# ─── Lead generation: Apollo ───────────────────────────
# apollo.io → Settings → API. Empty = Apollo search disabled (CSV import still works).
APOLLO_API_KEY=""
APOLLO_BASE_URL="https://api.apollo.io"

# ─── Email verification: ZeroBounce ────────────────────
# zerobounce.net → API. Empty = verification disabled (leads stay 'unverified').
ZEROBOUNCE_API_KEY=""
ZEROBOUNCE_BASE_URL="https://api.zerobounce.net/v2"

# ─── Gmail channel (OAuth) ─────────────────────────────
# console.cloud.google.com → APIs & Services → Credentials (OAuth client).
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3001/gmail/oauth/callback"
GOOGLE_REFRESH_TOKEN=""

# ─── WhatsApp (Baileys, replies/opt-in only) ───────────
WHATSAPP_AUTH_DIR="./storage/whatsapp/auth"
